# ─── Script generation ──────────────────────────────────────────────
# EASIEST: a direct Anthropic key from console.anthropic.com. No other signup.
ANTHROPIC_API_KEY=
# Alternative: a Vercel AI Gateway key (routes "anthropic/..." strings). Only
# used if ANTHROPIC_API_KEY is empty.
AI_GATEWAY_API_KEY=

# ─── Text-to-speech: ElevenLabs (word-level timestamps for captions) ─
ELEVENLABS_API_KEY=
# Default voice = "Adam". Browse voices at elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ─── Visuals: stock (Pexels), royalty-free gameplay (Pixabay), AI (fal) ─
# Pexels — free stock B-roll. https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay — free royalty-free gameplay/satisfying backgrounds (strike-safe
# "brainrot" look). https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# fal.ai — ONE key unlocks AI image + video models (slideshow, brainrot,
# cinematic formats) AND the UGC portrait fallback.
# https://fal.ai/dashboard/keys
FAL_KEY=
# Optional model overrides (defaults are cheap/fast — see https://fal.ai/models):
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_VIDEO_MODEL=fal-ai/wan/v2.2-a14b/text-to-video
# Paid lip-sync (~$0.13/sec) when UGC_LIPSYNC=1. Default is the cheap portrait.
# https://fal.ai/models/fal-ai/sync-lipsync/v3/image-to-video
# FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v3/image-to-video
# UGC_LIPSYNC=1
# UGC_LIPSYNC=0

# ─── UGC / talking-head (optional) ──────────────────────────────────
# HeyGen lip-syncs the ElevenLabs track onto an avatar or a portrait.
# Signup: https://app.heygen.com/
# API key: https://developers.heygen.com/docs/api-key
# Then set heygenAvatarId on the host in data/influencers.json (or leave it
# blank and HeyGen animates the portrait). Without this key, FAL_KEY still
# renders a recurring "creator on a phone" still. The format does not crash
# if lip-sync fails — it falls back to that portrait.
HEYGEN_API_KEY=
# Which host from assets/influencers.json (or data/influencers.json) to use.
# UGC_INFLUENCER_ID=avery-cole

# ─── News seeds (optional — RSS works with no key) ──────────────────
# npm run news pulls Google News, BBC, and NPR RSS for the current-events track.
# NewsAPI is only an extra source: https://newsapi.org/register
NEWS_API_KEY=
# NEWS_MAX_AGE_HOURS=72

# ─── YouTube upload (OAuth desktop app credentials) ─────────────────
# Google Cloud Console → APIs → YouTube Data API v3 → OAuth client (Desktop)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Uploads default to "private" until you trust the output. Options:
# private | unlisted | public
YOUTUBE_PRIVACY=private

# ─── Channel strategy ───────────────────────────────────────────────
# The niche the whole pipeline writes for. Be specific — this is your edge.
NICHE=personal finance and investing: counterintuitive money facts with original analysis

# Appended to every video description — your affiliate links + follow CTA.
# This is where finance channels actually earn. Separate lines with \n.
# Example: CTA=📈 Free investing checklist: https://your.link\n🔔 Follow for daily money facts
CTA=
# Pre-monetization move: capture the audience with a FREE newsletter now, add
# affiliate links later. If CTA is empty, this auto-becomes the CTA.
NEWSLETTER_URL=

# ─── Cross-posting ──────────────────────────────────────────────────
# Which platforms to fan out to. Unconfigured ones are skipped silently.
PLATFORMS=youtube,tiktok,instagram,facebook

# TikTok Content Posting API — https://developers.tiktok.com (create an app,
# add the "Content Posting API" product, scopes: video.upload + video.publish).
# Run `npx tsx src/cli.ts tiktok-auth` once to grant access.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited apps can only push a DRAFT to your TikTok inbox (you tap publish).
# After Content Posting API audit approval, set this to 1 for full auto-publish.
TIKTOK_DIRECT_POST=0

# Meta Graph API — Instagram Reels + Facebook Reels. See SETUP-CROSSPOST.md for
# how to get a long-lived token, the IG Business user id, and the Page id.
META_ACCESS_TOKEN=
IG_USER_ID=
FB_PAGE_ID=
# META_GRAPH_VERSION=v21.0

# Cloudflare R2 — public host so Meta can fetch the mp4 (Reels are pull-by-URL).
# dash.cloudflare.com → R2 → create bucket → enable public r2.dev URL (or custom
# domain) → put that origin in R2_PUBLIC_BASE_URL. Create an API token for keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
